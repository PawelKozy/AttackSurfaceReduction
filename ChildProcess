Option Explicit

Sub GetWeatherAndTime()
    Dim weatherAndTime As String
    Dim fileName As String
    Dim filePath As String
    Dim fileNumber As Integer
    Dim shell As Object
    Dim command As String
    
    ' Fetch weather and time data using PowerShell and wttr.in
    command = "powershell -Command ""(Invoke-WebRequest 'https://wttr.in/London?format=%C+%t+%w+%T').Content"""
    Set shell = CreateObject("WScript.Shell")
    weatherAndTime = shell.Exec(command).StdOut.ReadAll
    
    ' Save weather and time to a file
    fileName = "WeatherAndTime.txt"
    filePath = "C:\Users\Public\" & fileName
    fileNumber = FreeFile
    
    On Error GoTo ErrorHandler
    Open filePath For Output As fileNumber
    Print #fileNumber, "In the background, I was able to connect to external website with powershell and fetch info about weather in London, save it in the file: " & filePath
    Print #fileNumber, weatherAndTime
    Close fileNumber
    On Error GoTo 0
    
    ' Display the contents of the file
    shell.Run "notepad.exe " & filePath, 1, True
    Exit Sub
    
ErrorHandler:
    MsgBox "An error occurred while trying to save the file. ASR is blocking", vbCritical, "Error"
    On Error GoTo 0
End Sub

