let unusual_extensions = 
    dynamic(["*.dll", "*.cpl", "*.tmp", "*.exe", "*.tlb", "*.scr", "*.dll.mui", "*.ime", "*.tsp", "*.rbf"]);
let excluded_dll_paths = 
    dynamic(["C:\\Windows\\System32\\winspool.drv", "C:\\Windows\\SysWOW64\\winspool.drv",
             "C:\\Windows\\System32\\*.ime", "C:\\Windows\\SysWOW64\\*.ime",
             "C:\\Windows\\System32\\spool\\drivers\\*", "C:\\Program Files (x86)\\*", 
             "C:\\Program Files\\*", "C:\\Windows\\SysWOW64\\*.bpl"]);
let excluded_dll_hashes = 
    dynamic(["cfd375eb124d1fba73f2d46705a43ed30e8aaadca7627bab7718f674fb82df38", 
             "4af03da6cda5d673725b671dbb3fccfc4badc0651af9065216bdcddb0fef7adf", 
             "bf03c44224a2932e4c12ce02e12059f5c37b7d7ebfbbe4f2603b324c368ba2b9", 
             "9e318b33d7ae4ece36cdcd345ff6815816f9efcaf9a9b943999c6d80ae043e91"]);
let excluded_processes = 
    dynamic(["?:\\ProgramData\\Lenovo\\ImController\\Plugins\\LenovoBatteryGaugePackage\\*\\BGHelper.exe"]);
let excluded_args = 
    dynamic(["ShowBatteryGauge", "updatestatus"]);
let excluded_regsvr32_dlls = 
    dynamic(["C:\\Program Files (x86)\\DesktopCentral_Agent\\bin\\BSPHelperObject.dll", 
             "\\\\*\\FullCase\\pegasusimaging.activex.imagxpress*.dll"]);

union 
(
    ProcessCreationEvents 
    | where ActionType == "ProcessCreated" 
    | where 
        (
            ProcessCommandLine contains "rundll32.exe" or 
            ProcessCommandLine contains "regsvr32.exe"
        ) and
        (
            ProcessCommandLine !contains_any excluded_args and 
            ProcessCommandLine !contains_any excluded_regsvr32_dlls
        ) and 
        (
            not (ProcessParentFileName == "svchost.exe" and ProcessCommandLine contains "taskkill /im") and 
            not (ProcessParentFileName == "taskhostw.exe" and ProcessCommandLine contains "taskkill /f /im") and 
            not (ProcessCommandLine contains "verclsid.exe" and ProcessCommandLine contains "/S") and 
            not (ProcessCommandLine contains "taskeng.exe" and ProcessCommandLine contains "/Run")
        )
    | extend dll = extract(".+\\\\(.+?)\"", 1, DynamicArray(["*"]), ProcessCommandLine)
    | where 
        dll !in (unusual_extensions) and 
        not (dll endswith ".dll.mui") and 
        not (dll endswith ".ime" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".ocx" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".ax" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".bpl" and ProcessCommandLine contains "regsvr32.exe")
    | where 
        (
            ProcessCommandLine contains "rundll32.exe" or 
            ProcessCommandLine contains "regsvr32.exe"
        )
    | where not (
        ProcessCommandLine contains_any excluded_args and 
        ProcessCommandLine contains_any excluded_regsvr32_dlls
    )
    | extend dll = extract(".+\\\\(.+?)\"", 1, DynamicArray(["*"]), ProcessCommandLine)
    | where 
        not (dll endswith ".dll.mui") and 
        not (dll endswith ".ime" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".ocx" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".ax" and ProcessCommandLine contains "regsvr32.exe") and 
        not (dll endswith ".bpl" and ProcessCommandLine contains "regsvr32.exe") and 
        dll !in (unusual_extensions) and 
        not (dll in excluded_dll_paths) and 
        not (dll.sha256 in excluded_dll_hashes) and 
        not (ProcessCommandLine contains_any excluded_processes)
) 
| project TimeGenerated, ComputerName, AccountName, ProcessCommandLine, dll
| summarize arg_max(TimeGenerated, *) by ComputerName, ProcessCommandLine, dll
| where ActionType == "ProcessCreated"
| join 
(
    ProcessCreationEvents 
    | where ActionType == "ProcessCreated" 
    | where ProcessCommandLine == "rundll32.exe advpack.dll,RegisterOCX *" or 
          ProcessCommandLine == "regsvr32 /s /u *" or 
          ProcessCommandLine == "regsvr32 /s *" or 
          ProcessCommandLine == "regsvr32 /i /s *" or 
          ProcessCommandLine == "regsvr32 /i *" or 
          ProcessCommandLine == "regsvr32 /u /s *" or 
          ProcessCommandLine == "regsvr32 /u *" or 
          ProcessCommandLine == "rundll32 shell32.dll,Control_RunDLL *.dll" 
    | extend dll = extract(".+\\\\(.+?)\"", 1, DynamicArray(["*"]), ProcessCommandLine)
    | summarize arg_max(TimeGenerated, *) by ComputerName, ProcessCommandLine, dll
    | where ActionType == "ProcessCreated"
) on ComputerName, ProcessCommandLine, dll
| where arg_max_TimeGenerated1 - arg_max_TimeGenerated2 > 1m
| project arg_max_TimeGenerated1, ComputerName, AccountName, ProcessCommandLine, dll
